lib/
node_modules/
.pnpm-store/
*.tgz
.DS_Store
coverage/

# Agent-tool state (session logs, checkpoints); no machine-local state belongs
# in the repository, and a contributor's machine may not have the global
# ignore rule that used to cover it.
.omc/

.cybernetics/

# A demo project's narration is paid, generated and machine-local: the manuscript
# and the deck are the source, `audio/` and `timings.json` are its output. The
# finished film lands under renders/, which has its own ignore file.
demo/*/audio/
demo/*/timings.json
demo/*/.dsh-video/

# A run directory keeps its own copies of the deck / scenes / cover (the manuscript
# may not point outside its own directory), so those stay tracked: they are what the
# recorder actually read. What it *produced* is machine-local, same reasoning as above.
demo/*/runs/*/audio/
demo/*/runs/*/timings.json
demo/*/runs/*/.dsh-video/
demo/*/runs/*/.page-hold.json

# Manim writes bytecode beside the scene file it imports.
__pycache__/

# video_teach_export writes the interactive deck here, at the workspace root.
# Anchored with a slash so it cannot swallow assets/teach/deck.
/deck/
