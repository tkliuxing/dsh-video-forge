.DS_Store
coverage/

# Agent-tool state (session logs, checkpoints); no machine-local state belongs
# in the repository, and a contributor's machine may not have the global
# ignore rule that used to cover it.
.omc/

.cybernetics/

# A demo project's narration is paid, generated and machine-local: the manuscript
# and the deck are the source, `audio/` and `timings.json` are its output. The
# finished film lands under renders/, which has its own ignore file.
demo/*/audio/
demo/*/timings.json
demo/*/.dsh-video/
